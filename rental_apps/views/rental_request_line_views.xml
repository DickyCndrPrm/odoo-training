<odoo>
  <record id="rental_request_line_list_view" model="ir.ui.view">
    <field name="name">rental.request.line.list</field>
    <field name="model">rental.request.line</field>
    <field name="arch" type="xml">
      <list>
        <field name="request_id"/>
        <field name="brand_id"/>
        <field name="model_id"/>
        <field name="quantity"/>
      </list>
    </field>
  </record>

  <record id="rental_request_line_form_view" model="ir.ui.view">
    <field name="name">rental.request.line.form</field>
    <field name="model">rental.request.line</field>
    <field name="arch" type="xml">
      <form string="Rental Request Line">
        <sheet>
          <group>
            <group>
              <field name="request_id"/>
              <field name="brand_id"/>
            </group>
            <group>
              <field name="model_id" domain="[('brand_id', '=', brand_id)]"/>
              <field name="quantity"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="rental_request_line_search_view" model="ir.ui.view">
    <field name="name">rental.request.line.search</field>
    <field name="model">rental.request.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="request_id"/>
        <field name="brand_id"/>
        <field name="model_id"/>

        <separator/>
        <filter name="qty_gt_1" string="Quantity > 1" domain="[('quantity', '&gt;', 1)]"/>

        <separator/>
        <filter name="group_by_request" string="Request" context="{'group_by': 'request_id'}"/>
        <filter name="group_by_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
        <filter name="group_by_model" string="Model" context="{'group_by': 'model_id'}"/>
      </search>
    </field>
  </record>

  <record id="rental_request_line_pivot_view" model="ir.ui.view">
    <field name="name">rental.request.line.pivot</field>
    <field name="model">rental.request.line</field>
    <field name="arch" type="xml">
      <pivot string="Rental Request Line Analysis">
        <field name="quantity" type="measure"/>
        <field name="request_id" type="row"/>
        <field name="brand_id" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="rental_request_line_record" model="ir.actions.act_window">
    <field name="name">Rental Request Lines</field>
    <field name="res_model">rental.request.line</field>
    <field name="view_mode">list,form,pivot</field>
    <field name="search_view_id" ref="rental_request_line_search_view"/>
  </record>
</odoo>

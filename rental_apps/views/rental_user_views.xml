<odoo>
  <record id="view_users_form_rental_approval" model="ir.ui.view">
    <field name="name">res.users.form.rental.approval</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='access_rights']/group" position="inside">
        <group string="Rental Approval">
          <field name="rental_approval_level"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>

<odoo>
  <record id="view_company_form_leasing_amortization" model="ir.ui.view">
    <field name="name">res.company.form.leasing.amortization</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Leasing Amortization Defaults">
          <group>
            <field name="leasing_vendor_bill_journal_id"/>
            <field name="leasing_interest_expense_account_id"/>
          </group>
          <group>
            <field name="leasing_lease_payable_account_id"/>
            <field name="leasing_accounts_payable_account_id"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>

<odoo>
  <record id="estate_property_offer_list_view" model="ir.ui.view">
    <field name="name">estate.property.offer.view.list</field>
    <field name="model">estate.property.offer</field>
    <field name="arch" type="xml">
      <list editable="bottom" decoration-success="status == 'accept'" decoration-bf="status == 'refuse'">
        <field name="price"/>
        <field name="partner_id"/>
        <button name="action_accept_offer" string="Accept" type="object" icon="fa-check"></button>
        <button name="action_refuse_offer" string="Refuse" type="object" icon="fa-times"></button>
      </list>
    </field>
  </record>

  <record id="estate_property_offer_form_view" model="ir.ui.view">
    <field name="name">estate.property.offer.view.form</field>
    <field name="model">estate.property.offer</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="price" placeholder="1000"/>
            <field name="partner_id"/>
            <field name="status"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="estate_property_offer_record" model="ir.actions.act_window">
    <field name="name">Estate Property Offer</field>
    <field name="res_model">estate.property.offer</field>
    <field name="domain">[('property_type_id', '=', active_id)]</field>
    <field name="context">{'default_property_type_id': active_id}</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>